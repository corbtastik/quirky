{#
  Yolo's sticky chrome: light/dark on one axis, colour palette on the other.

  It is position: fixed and pointer-events: none except on the buttons
  themselves, so it floats over the layout without taking part in it - the
  nav column and the content keep the widths they would have had.
#}
<div class="yolo-sticky-controls">
    <div class="yolo-sticky-top-right">
        <div class="yolo-theme-toggle">
            {# Matches the default light mode; quirky.js re-seeds it from the stored mode. #}
            <span id="theme-toggle" class="material-icons md-36" role="button"
                  tabindex="0" title="Light / dark" aria-label="Light / dark">dark_mode</span>
        </div>
        {# Home. Second in the column, under the light/dark toggle, as asked.
           A link rather than a button, because that is what it is - it
           borrows .quirky-icon-button only for the chrome reset, which strips
           a button's styling and is harmless on an anchor. #}
        <div class="quirky-home">
            <a href="{{ '/' | relative_url }}" class="quirky-icon-button"
               title="Home" aria-label="Home">
                <span class="material-icons md-36" aria-hidden="true">home</span>
            </a>
        </div>
        {# The list is built by palette.js from the same themes.json the build
           reads, so this stays a button and an empty box. #}
        <div id="theme-picker" class="yolo-theme-picker">
            <button type="button" id="palette-toggle" class="yolo-palette-toggle"
                    aria-label="Colour theme" aria-expanded="false"
                    aria-controls="palette-menu" title="Colour theme">
                <span class="material-icons md-36" aria-hidden="true">palette</span>
            </button>
            <ul id="palette-menu" class="yolo-themes-menu" hidden></ul>
        </div>
        {# Side swap. Third in the column, so it lands under the palette -
           the container is a flex column with a gap and needs no help
           stacking.

           The arrow points the way the chrome is about to move: < sends the
           controls to the left corner and the nav to the right, > puts both
           back. Same convention as the light/dark toggle above it, where the
           icon is the action rather than the state.

           It only does anything on the stream, so _controls.scss only shows
           it there. #}
        <div class="quirky-side-swap">
            <button type="button" id="side-swap" class="quirky-icon-button"
                    aria-pressed="false" aria-label="Swap the sides"
                    title="Swap the sides">
                <span class="material-icons md-36" aria-hidden="true">chevron_left</span>
            </button>
        </div>
        {# Page alignment. Middle, left, right - in that order, middle
           being what the site has always done. Each sets data-pull on
           <html>; _controls.scss drops the margin on the matching side. #}
        <div class="quirky-align">
            <button type="button" id="align-center" class="quirky-icon-button"
                    data-align="center" aria-pressed="true"
                    aria-label="Centre the site" title="Centre the site">
                <span class="material-icons md-36" aria-hidden="true">align_horizontal_center</span>
            </button>
            <button type="button" id="align-left" class="quirky-icon-button"
                    data-align="left" aria-pressed="false"
                    aria-label="Pin the site left" title="Pin the site left">
                <span class="material-icons md-36" aria-hidden="true">align_horizontal_left</span>
            </button>
            <button type="button" id="align-right" class="quirky-icon-button"
                    data-align="right" aria-pressed="false"
                    aria-label="Pin the site right" title="Pin the site right">
                <span class="material-icons md-36" aria-hidden="true">align_horizontal_right</span>
            </button>
        </div>
    </div>
    <div class="yolo-sticky-bottom-right">
        <a href="#" class="yolo-to-top" title="Back to top" aria-label="Back to top">
            <span class="material-icons md-36">keyboard_double_arrow_up</span>
        </a>
    </div>
</div>
