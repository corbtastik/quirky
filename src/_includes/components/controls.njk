{#
  The control rail.

  It is a flex item inside main, not fixed chrome in a corner, because the
  layouts put it between the nav and the content as well as outside them -
  [nav][rail][content] is not reachable from a corner. Being in the flow, the
  six arrangements are six sets of `order` values and nothing has to be
  positioned by hand.

  It sticks to the top of the viewport as you scroll, the same way the nav
  does on the stream.

  Back to top is not here. That is navigation rather than a setting, and it
  stays pinned in its own corner - see to-top.njk.
#}
<aside class="quirky-rail" role="toolbar" aria-label="Site controls"
       aria-orientation="vertical">
    <div class="quirky-theme-toggle">
        {# Matches the default light mode; quirky.js re-seeds it from the stored mode. #}
        <span id="theme-toggle" class="material-icons md-36" role="button"
              tabindex="0" title="Light / dark" aria-label="Light / dark">dark_mode</span>
    </div>
    <div class="quirky-home">
        <a href="{{ '/' | relative_url }}" class="quirky-icon-button"
           title="Home" aria-label="Home">
            <span class="material-icons md-36" aria-hidden="true">home</span>
        </a>
    </div>
    {# The list is built by palette.js from the same themes.json the build
       reads, so this stays a button and an empty box. #}
    <div id="theme-picker" class="quirky-theme-picker">
        <button type="button" id="palette-toggle" class="quirky-palette-toggle"
                aria-label="Colour theme" aria-expanded="false"
                aria-controls="palette-menu" title="Colour theme">
            <span class="material-icons md-36" aria-hidden="true">palette</span>
        </button>
        <ul id="palette-menu" class="quirky-themes-menu" hidden></ul>
    </div>
    {# The six orderings of the three columns, as a radiogroup - they are
       exclusive choices. Each icon draws the page in miniature: narrow solid
       bar for this rail, medium block for the nav, wide ruled box for the
       content, in the order the layout puts them. #}
    <div class="quirky-layout" role="radiogroup" aria-label="Page layout">
        {%- set orders = [
            ["rail-nav-content", "Controls, sidebar, content"],
            ["rail-content-nav", "Controls, content, sidebar"],
            ["nav-rail-content", "Sidebar, controls, content"],
            ["nav-content-rail", "Sidebar, content, controls"],
            ["content-rail-nav", "Content, controls, sidebar"],
            ["content-nav-rail", "Content, sidebar, controls"]
        ] %}
        {%- for o in orders %}
        <button type="button" class="quirky-icon-button quirky-layout-option"
                id="layout-{{ o[0] }}" data-layout-choice="{{ o[0] }}"
                role="radio" aria-checked="{{ 'true' if o[0] == 'nav-content-rail' else 'false' }}"
                aria-label="{{ o[1] }}" title="{{ o[1] }}">
            {% layoutIcon o[0] %}
        </button>
        {%- endfor %}
    </div>
</aside>
