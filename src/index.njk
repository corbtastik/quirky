{#
  The stream: everything written, newest first, on one scroll.

  Notes hosted here link to their own page; notes written somewhere else link
  straight out and are marked as external. Both come from the same collection,
  so the stream is a record of what was written rather than a list of what
  this site happens to host.
#}
<ul class="post-list" id="stream">
    {%- for group in collections.notesByYear %}
    <li class="post-year" aria-hidden="true">{{ group.year }}</li>
    {%- for note in group.notes %}
    {%- include "components/note-row.njk" %}
    {%- endfor %}
    {%- endfor %}
</ul>
