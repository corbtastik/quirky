---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.w3.org/schemas/sitemap/0.9">
  {#- Only pages this site serves. Notes that live elsewhere have no URL here
      to list - they are `permalink: false`, so collections.all skips them. -#}
  {%- for item in collections.all %}
  {%- if item.url %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    <lastmod>{{ item.date | date('YYYY-MM-DD') }}</lastmod>
  </url>
  {%- endif %}
  {%- endfor %}
</urlset>
